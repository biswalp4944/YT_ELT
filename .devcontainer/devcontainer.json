{
  "name": "YT ELT Airflow",
  "dockerComposeFile": "../docker-compose.yaml",
  "service": "airflow-scheduler",
  "workspaceFolder": "/opt/airflow/dags",
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/airflow/.local/bin/python"
      }
    }
  }
}